# Coolify Environment Configuration for Sentry Self-Hosted
# Copy this to .env and customize as needed

# Basic Configuration
COMPOSE_PROJECT_NAME=sentry-self-hosted
COMPOSE_PROFILES=feature-complete

# Sentry Configuration
SENTRY_EVENT_RETENTION_DAYS=90
SENTRY_MAIL_HOST=smtp

# Docker Images - Using official Sentry images
SENTRY_IMAGE=ghcr.io/getsentry/sentry:25.8.0
SNUBA_IMAGE=ghcr.io/getsentry/snuba:25.8.0
RELAY_IMAGE=ghcr.io/getsentry/relay:25.8.0
SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:25.8.0
TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:25.8.0
VROOM_IMAGE=ghcr.io/getsentry/vroom:25.8.0
UPTIME_CHECKER_IMAGE=ghcr.io/getsentry/uptime-checker:25.8.0

# Health Check Configuration
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=90s
HEALTHCHECK_RETRIES=10
HEALTHCHECK_START_PERIOD=10s
HEALTHCHECK_FILE_INTERVAL=60s
HEALTHCHECK_FILE_TIMEOUT=10s
HEALTHCHECK_FILE_RETRIES=3
HEALTHCHECK_FILE_START_PERIOD=600s

# Database Configuration
POSTGRES_MAX_CONNECTIONS=100

# Secret Key (will be auto-generated if not set)
# SENTRY_SECRET_KEY=your-secret-key-here

# Optional: Email Configuration
# SENTRY_MAIL_USERNAME=
# SENTRY_MAIL_PASSWORD=
# SENTRY_MAIL_USE_TLS=false
# SENTRY_MAIL_USE_SSL=false

# Optional: External integrations
# SENTRY_GITHUB_APP_ID=
# SENTRY_GITHUB_API_SECRET=
# SENTRY_SLACK_CLIENT_ID=
# SENTRY_SLACK_CLIENT_SECRET=

# Optional: Performance tuning
# UWSGI_MAX_REQUESTS=10000
# CELERY_WORKER_CONCURRENCY=4